<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue library="false" id="e971-b31b-b278-5da6" name="Genestealer Cults" gameSystemId="sys-86a7-ff6f-05e6-a304" gameSystemRevision="11" revision="4" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
    <catalogueLink type="catalogue" name="aLib - Imperial - Base" id="3f5a-473f-8878-4c9d" targetId="0d98-1036-43bc-85f0"/>
  </catalogueLinks>
  <rules>
    <rule name="Cult Ambush" id="82bc-cdb2-b38d-8b6b" hidden="false">
      <description>At the start of the battle, roll 1d3 for every 500 points, rounding down (eg. 0 for 0-500 pts 1d3 for 501-1000 pts, 2d3 for 1001-1500 pts, 3d3 for 1501-2000 pts, etc.). This is the number of Cult Ambush tokens you have access to.


During deployment, you can expend any number of Cult Ambush markers to give a unit either Infiltrate or Deep Strike (up to half the number of units in your army). 


In the Command Phase, when adding Priority Dice to the pool, you may also expend any number of Cult Ambush tokens to add additional dice.


Units can still only be activated once, so Cult Ambush tokens do not provide additional activations in a turn.</description>
    </rule>
  </rules>
  <sharedRules>
    <rule name="Cult Icon" id="8de1-eb00-c8bc-15b9" hidden="false">
      <description>A unit that contains a model with a Cult Icon increases their WS by 1.</description>
    </rule>
  </sharedRules>
